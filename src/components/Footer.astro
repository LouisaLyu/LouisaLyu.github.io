---
import { words } from '../lib/text';

const site = (await words('site')).data;
const year = new Date().getFullYear();
---

{/* No page menu here; the header has it (Louisa, 2026-10-13). The links sit
    under the email in the same type, each reading as the site and your
    name, e.g. "LinkedIn: Louisa Lyu". */}
<footer class="site-footer theme-dark">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__contact">
        <a class="site-footer__link" href={`mailto:${site.email}`}>{site.email}</a>
        <ul aria-label="Elsewhere">
          {site.links.map((link) => (
            <li><a class="site-footer__link" href={link.href} target="_blank" rel="noopener">{link.label}: {site.name}<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          ))}
        </ul>
      </div>
      <p class="site-footer__small">© {year} {site.name}</p>
    </div>
    <p class="site-footer__wordmark" aria-hidden="true">{site.wordmark}</p>
  </div>
</footer>
