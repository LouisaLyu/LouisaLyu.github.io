---
// Reading text: Source Serif 4 with optical sizes. Its italic (only a few words,
// e.g. project names) uses the weight-only file, 50 KB instead of 127 KB, so
// phones load the page sooner.
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { words } from '../lib/text';

interface Props {
  title?: string; // the page's name; the tab reads "Title — Name"
  tabTitle?: string; // or the whole tab title (Home)
  description?: string;
  progress?: boolean; // reading-progress line in the header (project pages)
  image?: ImageMetadata; // link-preview image; project pages pass their cover
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean; // the 404 page
}

const site = (await words('site')).data;
const { title, tabTitle, description = site.description, progress = false, image, imageAlt, type = 'website', noindex = false } = Astro.props;
const pageTitle = tabTitle ?? (title ? `${title} — ${site.name}` : site.name);
// Link previews (Open Graph) need full addresses. They come from `site` in
// astro.config.mjs: the local preview until the deploy sets SITE_URL.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const share = image ? await getImage({ src: image, width: 1200, height: 630, format: 'jpg' }) : undefined;
const shareImage = new URL(share ? share.src : url('/og.jpg'), Astro.site).href;
const shareAlt = image && imageAlt ? imageAlt : `${site.name}: ${site.tagline}`;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Switzer's licence (ITF Free Font License) allows web use through Fontshare's own
         service only, so it is loaded from there rather than self-hosted. -->
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=switzer@1&display=swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grid-overlay" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <Header progress={progress} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
